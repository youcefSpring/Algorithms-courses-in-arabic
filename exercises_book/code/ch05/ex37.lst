#include <stdio.h>

int main(void) {
    double qty[3][3] = {{2, 1, 3},       (*@\cmt{الفاتورة \cen{1}: الكميات}@*)
                        {1, 4, 1},
                        {3, 2, 2}};
    double totals[3] = {5100, 4300, 6200};
    double work[3][3], det, detReplaced, price[3];
    int unknown, row, col;
    (*@\cmt{قاعدة ساروس: مجموع الأقطار ناقص مجموع الأقطار المعاكسة}@*)
    det = qty[0][0] * qty[1][1] * qty[2][2] + qty[0][1] * qty[1][2] * qty[2][0]
        + qty[0][2] * qty[1][0] * qty[2][1] - qty[0][2] * qty[1][1] * qty[2][0]
        - qty[0][0] * qty[1][2] * qty[2][1] - qty[0][1] * qty[1][0] * qty[2][2];
    if (det == 0) {
        printf("No unique solution\n");
        return 0;
    }
    for (unknown = 0; unknown < 3; unknown++) {
        for (row = 0; row < 3; row++)
            for (col = 0; col < 3; col++)
                work[row][col] = (col == unknown) ? totals[row] : qty[row][col];
        detReplaced = work[0][0] * work[1][1] * work[2][2] + work[0][1] * work[1][2] * work[2][0]
                    + work[0][2] * work[1][0] * work[2][1] - work[0][2] * work[1][1] * work[2][0]
                    - work[0][0] * work[1][2] * work[2][1] - work[0][1] * work[1][0] * work[2][2];
        price[unknown] = detReplaced / det;
        printf("Product %d: %.2f DA\n", unknown, price[unknown]);
    }
    printf("det = %.0f\n", det);
    return 0;
}
