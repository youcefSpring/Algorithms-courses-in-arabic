#include <stdio.h>

int main(void) {
    double sales[7] = {1200, 980, 1430, 1100, 1290, 1650, 1520};
    double *ptr, *end = sales + 7, total = 0;
    for (ptr = sales; ptr < end; ptr++)        (*@\cmt{المؤشر يتقدم بخانة}@*)
        total += *ptr;
    printf("Week total: %.2f DA\n", total);
    printf("Third day via pointer: %.2f (= sales[2])\n", *(sales + 2));
    return 0;
}
