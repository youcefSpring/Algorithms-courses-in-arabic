#include <stdio.h>

char *trim(char *text) {
    char *start = text, *end;
    while (*start == ' ') start++;               (*@\cmt{فراغات البداية}@*)
    if (*start == '\0') return start;             (*@\cmt{نص فارغ}@*)
    end = start;
    while (*(end + 1) != '\0') end++;             (*@\cmt{آخر حرف}@*)
    while (end > start && *end == ' ') end--;     (*@\cmt{فراغات النهاية}@*)
    *(end + 1) = '\0';
    return start;
}

int main(void) {
    char inputs[3][40] = {"   amina@mail.dz  ", "Oran   ", "      "};
    int idx;
    for (idx = 0; idx < 3; idx++)
        printf("[%s]\n", trim(inputs[idx]));
    return 0;
}
