#include <stdio.h>

#define NB_POS 5
#define NB_NEG 5

int main(void) {
    char review[] = "Good product, fast delivery but the box was broken. Excellent price!";
    (*@\cmt{الكلمات \cen{0..4} إيجابية، و \cen{5..9} سلبية}@*)
    char lexicon[NB_POS + NB_NEG][12] = {"good", "fast", "excellent", "great", "cheap",
                                         "bad", "slow", "broken", "late", "fake"};
    char word[30], ch;
    int pos = 0, length, index, cmp, score = 0;
    while (review[pos] != '\0') {
        length = 0;
        while (1) {                           (*@\cmt{نقرأ الكلمة التالية}@*)
            ch = review[pos];
            if (ch >= 'A' && ch <= 'Z') ch += 'a' - 'A';
            if (ch < 'a' || ch > 'z') break;
            word[length++] = ch;
            pos++;
        }
        word[length] = '\0';
        if (review[pos] != '\0') pos++;       (*@\cmt{نتجاوز الفاصل}@*)
        if (length == 0) continue;
        for (index = 0; index < NB_POS + NB_NEG; index++) {
            for (cmp = 0; word[cmp] == lexicon[index][cmp] && word[cmp] != '\0'; cmp++) ;
            if (word[cmp] == lexicon[index][cmp]) {   (*@\cmt{تطابق كامل}@*)
                score += (index < NB_POS) ? 1 : -1;
                printf("%s: %+d\n", word, (index < NB_POS) ? 1 : -1);
            }
        }
    }
    printf("Score = %d -> %s\n", score, score > 0 ? "positive" : score < 0 ? "negative" : "neutral");
    return 0;
}
