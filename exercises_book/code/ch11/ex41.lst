#include <stdio.h>

#define CHUNK 4
#define MAXR 10

void runName(int idx, char *name) {
    name[0] = 'r'; name[1] = 'u'; name[2] = 'n'; name[3] = (char)('0' + idx);
    name[4] = '.'; name[5] = 't'; name[6] = 'x'; name[7] = 't'; name[8] = '\0';
}

int main(void) {
    FILE *file = fopen("amounts.txt", "w"), *runs[MAXR], *out;
    int data[14] = {4500, 120, 9800, 3300, 760, 15000, 230, 8900, 4100, 50, 6200, 1100, 7300, 990};
    int buffer[CHUNK], count, idx, back, key, nbRuns = 0, heads[MAXR], alive[MAXR], best, value;
    char name[9];
    for (idx = 0; idx < 14; idx++) fprintf(file, "%d\n", data[idx]);
    fclose(file);
    file = fopen("amounts.txt", "r");
    do {                                                   (*@\cmt{المرحلة \cen{1}: دفعات مرتبة}@*)
        for (count = 0; count < CHUNK && fscanf(file, "%d", &buffer[count]) == 1; count++) {}
        if (count == 0) break;
        for (idx = 1; idx < count; idx++) {
            key = buffer[idx];
            for (back = idx - 1; back >= 0 && buffer[back] > key; back--) buffer[back + 1] = buffer[back];
            buffer[back + 1] = key;
        }
        runName(nbRuns, name);
        out = fopen(name, "w");
        printf("%s:", name);
        for (idx = 0; idx < count; idx++) { fprintf(out, "%d\n", buffer[idx]); printf(" %d", buffer[idx]); }
        printf("\n");
        fclose(out);
        nbRuns++;
    } while (count == CHUNK);
    fclose(file);
    for (idx = 0; idx < nbRuns; idx++) {                   (*@\cmt{المرحلة \cen{2}: دمج متعدد}@*)
        runName(idx, name);
        runs[idx] = fopen(name, "r");
        alive[idx] = fscanf(runs[idx], "%d", &heads[idx]) == 1;
    }
    out = fopen("sorted.txt", "w");
    while (1) {
        best = -1;
        for (idx = 0; idx < nbRuns; idx++)
            if (alive[idx] && (best < 0 || heads[idx] < heads[best])) best = idx;
        if (best < 0) break;
        fprintf(out, "%d\n", heads[best]);
        alive[best] = fscanf(runs[best], "%d", &heads[best]) == 1;
    }
    for (idx = 0; idx < nbRuns; idx++) fclose(runs[idx]);
    fclose(out);
    out = fopen("sorted.txt", "r");
    printf("merged:");
    while (fscanf(out, "%d", &value) == 1) printf(" %d", value);
    printf("\n");
    fclose(out);
    return 0;
}
