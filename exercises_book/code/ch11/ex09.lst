#include <stdio.h>

int main(void) {
    FILE *file = fopen("terms.txt", "w");
    char line[100];
    int number = 0, len;
    fprintf(file, "Returns accepted within 14 days.\nWarranty: 12 months.\n");
    fprintf(file, "Free delivery above 10000 DA.\n");
    fclose(file);
    file = fopen("terms.txt", "r");
    if (file == NULL) return 1;
    while (fgets(line, 100, file) != NULL) {
        number++;
        for (len = 0; line[len] != '\0' && line[len] != '\n'; len++) {}
        line[len] = '\0';                      (*@\cmt{نحذف '\\cen{n}'}@*)
        printf("%2d (%2d chars) %s\n", number, len, line);
    }
    fclose(file);
    return 0;
}
