#include <stdio.h>

void printHex(long number, int digits) {
    char symbols[] = "0123456789ABCDEF";
    if (digits == 0) return;
    printHex(number / 16, digits - 1);       (*@\cmt{الخانات الأعلى}@*)
    putchar(symbols[number % 16]);
}

int main(void) {
    long colors[4] = {16711680, 65280, 3368601, 16753920};
    char names[4][8] = {"red", "green", "teal", "orange"};
    int idx;
    for (idx = 0; idx < 4; idx++) {
        printf("%-7s %8ld -> #", names[idx], colors[idx]);
        printHex(colors[idx], 6);
        printf("\n");
    }
    return 0;
}
