#include <stdio.h>

long digitSum(long number) {
    if (number < 10) return number;
    return number % 10 + digitSum(number / 10);
}

long digitalRoot(long number) {
    if (number < 10) return number;
    printf("%ld -> ", number);
    return digitalRoot(digitSum(number));     (*@\cmt{نكرر على مجموع الأرقام}@*)
}

int main(void) {
    long number, root;
    scanf("%ld", &number);
    root = digitalRoot(number);
    printf("%ld\n", root);
    printf("Check: 1 + (%ld - 1) %% 9 = %ld\n", number, 1 + (number - 1) % 9);
    return 0;
}
