#include <stdio.h>

void printAmount(long amount) {
    if (amount < 1000) {
        printf("%ld", amount);            (*@\cmt{الجزء الأول دون أصفار}@*)
        return;
    }
    printAmount(amount / 1000);
    printf(",%03ld", amount % 1000);      (*@\cmt{مجموعات من ثلاثة أرقام}@*)
}

int main(void) {
    long amount;
    int idx;
    for (idx = 0; idx < 4; idx++) {
        scanf("%ld", &amount);
        printAmount(amount);
        printf(" DA\n");
    }
    return 0;
}
