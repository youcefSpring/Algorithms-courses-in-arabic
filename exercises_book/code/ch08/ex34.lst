#include <stdio.h>

int depthReached = 0;

double rootBisect(double value, double low, double high) {
    double middle = (low + high) / 2;
    depthReached++;
    if (high - low < 1e-9) return middle;            (*@\cmt{دقة كافية}@*)
    if (middle * middle > value)
        return rootBisect(value, low, middle);
    return rootBisect(value, middle, high);
}

int main(void) {
    double values[4] = {2, 0.25, 144, 1000000}, root;
    int idx;
    for (idx = 0; idx < 4; idx++) {
        depthReached = 0;
        root = rootBisect(values[idx], 0, values[idx] > 1 ? values[idx] : 1);
        printf("sqrt(%.2f) = %.8f (%d calls)\n", values[idx], root, depthReached);
    }
    return 0;
}
