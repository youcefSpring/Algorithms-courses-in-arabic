#include <stdio.h>

int main(void) {
    int day, prep, deliveryDay;
    scanf("%d %d", &day, &prep);
    deliveryDay = (day + prep) % 7;             (*@\cmt{اليوم الطبيعي للتوصيل}@*)
    if (deliveryDay == 5 || deliveryDay == 6) {           (*@\cmt{الجمعة أو السبت}@*)
        printf("Weekend: postponed to Sunday\n");
        deliveryDay = 0;
    }
    printf("Delivery day: ");
    switch (deliveryDay) {
        case 0: printf("Sunday\n"); break;
        case 1: printf("Monday\n"); break;
        case 2: printf("Tuesday\n"); break;
        case 3: printf("Wednesday\n"); break;
        case 4: printf("Thursday\n"); break;
    }
    return 0;
}
