#include <stdio.h>

int main(void) {
    double price1, price2, price3, tmp;
    scanf("%lf %lf %lf", &price1, &price2, &price3);
    if (price1 > price2) { tmp = price1; price1 = price2; price2 = tmp; }   (*@\cmt{الآن \cen{price1} <= \cen{price2}}@*)
    if (price2 > price3) { tmp = price2; price2 = price3; price3 = tmp; }   (*@\cmt{الأكبر صعد إلى \cen{price3}}@*)
    if (price1 > price2) { tmp = price1; price1 = price2; price2 = tmp; }   (*@\cmt{نرتب الاثنين الأولين من جديد}@*)
    printf("Sorted: %.0f %.0f %.0f\n", price1, price2, price3);
    return 0;
}
