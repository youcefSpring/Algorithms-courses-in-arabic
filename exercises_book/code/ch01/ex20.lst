#include <stdio.h>

int main(void) {
    int days, weeks, rw, mo, rm;
    scanf("%d", &days);
    weeks = days / 7;   rw = days % 7;      (*@\cmt{أسابيع كاملة + أيام}@*)
    mo = days / 30; rm = days % 30;     (*@\cmt{أشهر تقريبية + أيام}@*)
    printf("%d days = %d weeks + %d days\n", days, weeks, rw);
    printf("%d days = %d months + %d days\n", days, mo, rm);
    return 0;
}
