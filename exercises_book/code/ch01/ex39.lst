#include <stdio.h>

int main(void) {
    char category, next, low;
    int rank;
    scanf(" %c", &category);
    next = category + 1;                 (*@\cmt{الحرف الموالي في جدول \cen{ASCII}}@*)
    rank = category - 'A' + 1;           (*@\cmt{المسافة عن \cen{A}}@*)
    low = category + ('a' - 'A');        (*@\cmt{الفرق بين الصغير والكبير ثابت}@*)
    printf("Code ASCII = %d\n", category);
    printf("Next category = %c\n", next);
    printf("Rank = %d\n", rank);
    printf("Lowercase = %c\n", low);
    return 0;
}
