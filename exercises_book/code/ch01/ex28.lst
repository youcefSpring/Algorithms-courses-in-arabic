#include <stdio.h>

int main(void) {
    double slope, intercept, x1, x2, y1, y2;
    scanf("%lf %lf", &slope, &intercept);     (*@\cmt{معاملا النموذج}@*)
    scanf("%lf %lf", &x1, &x2);   (*@\cmt{ميزانيتان}@*)
    y1 = slope * x1 + intercept;              (*@\cmt{التنبؤ الأول}@*)
    y2 = slope * x2 + intercept;              (*@\cmt{التنبؤ الثاني}@*)
    printf("Prediction 1 = %.1f\n", y1);
    printf("Prediction 2 = %.1f\n", y2);
    printf("Gain = %.1f\n", y2 - y1);   // = slope × (x2 - x1)
    return 0;
}
