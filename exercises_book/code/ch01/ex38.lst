#include <stdio.h>

int main(void) {
    int centsA, centsB, totalCents;
    scanf("%d %d", &centsA, &centsB);       (*@\cmt{مبلغان بالسنتيم}@*)
    totalCents = centsA + centsB;                    (*@\cmt{جمع دقيق بلا أخطاء تقريب}@*)
    (*@\cmt{\%\cen{02d} تضمن ظهور الصفر: \cen{5} سنتيم تكتب \cen{05}}@*)
    printf("Total = %d.%02d DA\n", totalCents / 100, totalCents % 100);
    return 0;
}
