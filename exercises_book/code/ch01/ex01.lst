#include <stdio.h>

#define TVA 0.19                  (*@\cmt{نسبة الرسم \cen{19\%}}@*)

int main(void) {
    double ht, tax, ttc;          (*@\cmt{السعر دون رسوم، الرسم، السعر النهائي}@*)
    printf("Price HT: ");
    scanf("%lf", &ht);            (*@\cmt{قراءة السعر دون رسوم}@*)
    tax = ht * TVA;               (*@\cmt{قيمة الرسم}@*)
    ttc = ht + tax;               (*@\cmt{السعر النهائي}@*)
    printf("\nTax = %.2f DA\n", tax);
    printf("TTC = %.2f DA\n", ttc);
    return 0;
}
