#include <stdio.h>

int main(void) {
    int hour, minute, delay, total, ah, am;
    scanf("%d %d %d", &hour, &minute, &delay);
    total = hour * 60 + minute + delay;       (*@\cmt{الدقائق منذ منتصف الليل}@*)
    ah = (total / 60) % 24;       (*@\cmt{\% \cen{24} تعيد الساعة بعد \cen{23} إلى \cen{0}}@*)
    am = total % 60;              (*@\cmt{الدقائق}@*)
    printf("Arrival time: %02d:%02d\n", ah, am);
    return 0;
}
