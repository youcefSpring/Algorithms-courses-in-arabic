#include <stdio.h>

int main(void) {
    double price, amount;         (*@\cmt{سعر الوحدة ومبلغ السطر}@*)
    int qty;                      (*@\cmt{الكمية عدد صحيح}@*)
    scanf("%lf %d", &price, &qty);
    amount = price * qty;         (*@\cmt{المبلغ = السعر × الكمية}@*)
    printf("%d x %.2f = %.2f DA\n", qty, price, amount);
    return 0;
}
