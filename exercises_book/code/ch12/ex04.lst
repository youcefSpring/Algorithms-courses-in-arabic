#include <stdio.h>
#include <stdlib.h>

typedef struct Node { int code, stock; struct Node *next; } Node;

Node *pushFront(Node *head, int code, int stock) {
    Node *node = malloc(sizeof(Node));
    node->code = code; node->stock = stock; node->next = head;
    return node;
}

Node *find(Node *head, int code) {
    for (; head != NULL; head = head->next)
        if (head->code == code) return head;     (*@\cmt{العقدة نفسها}@*)
    return NULL;
}

int main(void) {
    Node *head = NULL, *node, *next;
    head = pushFront(head, 101, 12);
    head = pushFront(head, 205, 5);
    head = pushFront(head, 330, 40);
    node = find(head, 205);
    if (node != NULL) {
        node->stock -= 2;                        (*@\cmt{تعديل داخل القائمة}@*)
        printf("Product 205: stock now %d\n", node->stock);
    }
    printf("Product 999: %s\n", find(head, 999) == NULL ? "not found" : "found");
    printf("Check via list: 205 -> %d\n", find(head, 205)->stock);
    while (head != NULL) { next = head->next; free(head); head = next; }
    return 0;
}
