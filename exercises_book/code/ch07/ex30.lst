#include <stdio.h>

void countSizes(int sizes[], int count, int freq[]) {
    int idx;
    for (idx = 0; idx < 12; idx++) freq[idx] = 0;
    for (idx = 0; idx < count; idx++) freq[sizes[idx] - 35]++;   (*@\cmt{مقاس -> فهرس}@*)
}

int mode(int sizes[], int count) {
    int freq[12], idx, best = 0;
    countSizes(sizes, count, freq);
    for (idx = 1; idx < 12; idx++)
        if (freq[idx] > freq[best]) best = idx;
    return best + 35;
}

void printHistogram(int sizes[], int count) {
    int freq[12], idx, star;
    countSizes(sizes, count, freq);
    for (idx = 0; idx < 12; idx++)
        if (freq[idx] > 0) {
            printf("%d | ", idx + 35);
            for (star = 0; star < freq[idx]; star++) putchar('*');
            printf(" %d\n", freq[idx]);
        }
}

int main(void) {
    int sizes[18] = {42, 41, 43, 42, 40, 44, 42, 39, 41, 42, 43, 45, 41, 42, 38, 43, 42, 41};
    printHistogram(sizes, 18);
    printf("Most ordered size: %d\n", mode(sizes, 18));
    return 0;
}
