#include <stdio.h>

#define NS 3

void multiplyVector(double vec[], double matrix[NS][NS], double result[]) {
    int from, to;
    for (to = 0; to < NS; to++) {
        result[to] = 0;
        for (from = 0; from < NS; from++)
            result[to] += vec[from] * matrix[from][to];   (*@\cmt{من كل حالة نحو \cen{to}}@*)
    }
}

void multiplyMatrix(double left[NS][NS], double right[NS][NS], double result[NS][NS]) {
    int row, col, mid;
    for (row = 0; row < NS; row++)
        for (col = 0; col < NS; col++) {
            result[row][col] = 0;
            for (mid = 0; mid < NS; mid++)
                result[row][col] += left[row][mid] * right[mid][col];
        }
}

void printVector(int month, double vec[]) {
    printf("Month %2d: active %6.1f  idle %6.1f  churned %6.1f  (sum %.1f)\n",
           month, vec[0], vec[1], vec[2], vec[0] + vec[1] + vec[2]);
}

int main(void) {
    double trans[NS][NS] = {{0.80, 0.15, 0.05},
                            {0.30, 0.50, 0.20},
                            {0.00, 0.00, 1.00}};      (*@\cmt{المغادر لا يعود}@*)
    double current[NS] = {1000, 0, 0}, next[NS];
    double power[NS][NS], tmp[NS][NS];
    int month, row, col;
    for (month = 1; month <= 12; month++) {
        multiplyVector(current, trans, next);
        for (row = 0; row < NS; row++) current[row] = next[row];
        if (month == 1 || month == 3 || month == 6 || month == 12)
            printVector(month, current);
    }
    for (row = 0; row < NS; row++)
        for (col = 0; col < NS; col++) power[row][col] = trans[row][col];
    for (month = 2; month <= 12; month++) {             // P^12
        multiplyMatrix(power, trans, tmp);
        for (row = 0; row < NS; row++)
            for (col = 0; col < NS; col++) power[row][col] = tmp[row][col];
    }
    printf("P^12 first row: %.4f %.4f %.4f\n", power[0][0], power[0][1], power[0][2]);
    return 0;
}
