#include <stdio.h>

int maxOf(int values[], int size) {
    int idx, best = values[0];
    for (idx = 1; idx < size; idx++)
        if (values[idx] > best) best = values[idx];
    return best;
}

void printBar(char label[], int value, int maxValue, int width) {
    int len = value * width / maxValue, col;          (*@\cmt{طول متناسب}@*)
    printf("%-11s|", label);
    for (col = 0; col < len; col++) putchar('#');
    printf(" %d\n", value);
}

int main(void) {
    char names[5][12] = {"Phones", "Laptops", "Audio", "Accessories", "Gaming"};
    int sales[5] = {420, 185, 260, 510, 140};
    int top = maxOf(sales, 5), idx;
    for (idx = 0; idx < 5; idx++)
        printBar(names[idx], sales[idx], top, 30);
    return 0;
}
