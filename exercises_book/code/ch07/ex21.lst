#include <stdio.h>

int luhnValid(char number[]) {
    int length = 0, pos, digit, sum = 0, doubled = 0;
    while (number[length] != '\0') length++;
    for (pos = length - 1; pos >= 0; pos--) {     (*@\cmt{من اليمين}@*)
        digit = number[pos] - '0';
        if (doubled) {
            digit *= 2;
            if (digit > 9) digit -= 9;
        }
        sum += digit;
        doubled = !doubled;                       (*@\cmt{رقم من كل اثنين}@*)
    }
    return sum % 10 == 0;
}

int main(void) {
    char card[25];
    int idx;
    for (idx = 0; idx < 2; idx++) {
        scanf("%24s", card);
        printf("%s: %s\n", card, luhnValid(card) ? "valid" : "invalid");
    }
    return 0;
}
