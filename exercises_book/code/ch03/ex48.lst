#include <stdio.h>

int main(void) {
    long long number, lo, hi, mid, ans = 0;
    scanf("%lld", &number);
    lo = 0;
    hi = (number < 3000000000LL) ? number : 3000000000LL;  (*@\cmt{حد أعلى آمن للمربع}@*)
    while (lo <= hi) {
        mid = lo + (hi - lo) / 2;     (*@\cmt{يتجنب تجاوز السعة عند الجمع}@*)
        if (mid * mid <= number) {
            ans = mid;                (*@\cmt{مرشح صالح، نبحث عن أكبر}@*)
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    printf("isqrt(%lld) = %lld\n", number, ans);
    if (ans * ans == number)
        printf("Perfect square: grid %lld x %lld\n", ans, ans);
    else
        printf("Not a square: grid %lld x %lld\n", ans + 1, (number + ans) / (ans + 1));
    return 0;
}
