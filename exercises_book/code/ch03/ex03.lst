#include <stdio.h>

int main(void) {
    int nbReviews, index, rating, sum = 0;
    scanf("%d", &nbReviews);
    for (index = 0; index < nbReviews; index++) {
        scanf("%d", &rating);
        sum += rating;                 (*@\cmt{\cen{sum} += \cen{rating} تعني \cen{sum} = \cen{sum} + \cen{rating}}@*)
    }
    printf("Average = %.2f\n", (double)sum / nbReviews);
    return 0;
}
