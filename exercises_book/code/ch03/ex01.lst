#include <stdio.h>

int main(void) {
    int nbItems, item;
    double price, sum = 0;            (*@\cmt{المجمِّع يبدأ من الصفر}@*)
    scanf("%d", &nbItems);
    for (item = 1; item <= nbItems; item++) {    (*@\cmt{\cen{nbItems} تكرارًا بالضبط}@*)
        scanf("%lf", &price);
        sum = sum + price;            (*@\cmt{نضيف السعر الحالي}@*)
    }
    printf("Basket total = %.2f DA\n", sum);
    return 0;
}
