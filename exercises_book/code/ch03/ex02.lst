#include <stdio.h>

int main(void) {
    int nbOrders, index, count = 0;
    double amount;
    scanf("%d", &nbOrders);
    for (index = 0; index < nbOrders; index++) {
        scanf("%lf", &amount);
        if (amount > 10000)
            count++;              (*@\cmt{طلبية كبيرة: نزيد العداد}@*)
    }
    printf("Large orders: %d / %d (%.1f %%)\n", count, nbOrders, count * 100.0 / nbOrders);
    return 0;
}
