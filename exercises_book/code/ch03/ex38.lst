#include <stdio.h>

int main(void) {
    int nbHours, hour, jumps = 0;
    double prev, visits, change, ac;
    scanf("%d %lf", &nbHours, &prev);
    for (hour = 2; hour <= nbHours; hour++) {
        scanf("%lf", &visits);
        change = (visits - prev) / prev * 100;  (*@\cmt{التغير النسبي}@*)
        ac = (change < 0) ? -change : change;
        if (ac > 50) {
            printf("Hour %d: jump of %+.1f %%\n", hour, change);
            jumps++;
        }
        prev = visits;
    }
    printf("Total jumps: %d\n", jumps);
    return 0;
}
