#include <stdio.h>

int main(void) {
    double balance, rate, installment, interest, totI = 0;
    int month = 0;
    scanf("%lf %lf %lf", &balance, &rate, &installment);
    printf("Month | Interest | Remaining\n");
    while (balance > 0) {
        interest = balance * rate / 100;          (*@\cmt{فائدة الشهر على الباقي}@*)
        totI += interest;
        balance = balance + interest - installment;            (*@\cmt{نضيف الفائدة ونطرح القسط}@*)
        month++;
        if (balance < 0) balance = 0;         (*@\cmt{القسط الأخير يسدد ما تبقى فقط}@*)
        printf("%5d | %8.2f | %9.2f\n", month, interest, balance);
    }
    printf("Total interest = %.2f DA\n", totI);
    return 0;
}
